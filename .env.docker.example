DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-server-ip,your-domain.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://your-server-ip:8000,https://your-domain.com
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

POSTGRES_DB=primeshop
POSTGRES_USER=primeshop
POSTGRES_PASSWORD=change-this-db-password

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-this-admin-password
